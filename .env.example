# Copy to .env for local runs. Local values only — no real secret here.

APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info

# Host `postgres` is the Compose service; use `localhost` outside Compose.
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
DATABASE_URL=postgres://wagering:wagering@postgres:5432/wagering?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_LOCK_TIMEOUT=3s

SHUTDOWN_TIMEOUT=15s
STARTUP_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s

# OIDC_ISSUER_URL must match KC_HOSTNAME; OIDC_DISCOVERY_URL is the address the
# api container reaches Keycloak at.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=http://localhost:8081
OIDC_ISSUER_URL=http://localhost:8081/realms/wagering
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/wagering
OIDC_AUDIENCE=wagering-api

# LocalStack stands in for SQS; the credentials are what its signature check
# expects, not secrets.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

OUTBOX_QUEUE_URL=http://localstack:4566/000000000000/wager-events.fifo
OUTBOX_POLL_INTERVAL=1s
OUTBOX_PUBLISH_WINDOW=10s
OUTBOX_BATCH_SIZE=100

REFERENCE_POLL_INTERVAL=1s
REFERENCE_BATCH_SIZE=100
REFERENCE_TTL=24h
