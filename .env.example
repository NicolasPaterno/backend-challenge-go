# Copy to .env for local runs. Local values only — no real secret here.

APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=info

# Host `postgres` is the Compose service; use `localhost` outside Compose.
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
DATABASE_URL=postgres://wagering:wagering@postgres:5432/wagering?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=1

# SHUTDOWN_TIMEOUT drains in-flight requests on SIGTERM; STARTUP_TIMEOUT
# bounds the dependency checks at boot.
SHUTDOWN_TIMEOUT=15s
STARTUP_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
